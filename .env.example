# Copy to .env.local for development. Only public values: the anon (publishable)
# key is meant for browsers and only grants what row level security allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Push opt-in stays disabled until its database switch and device tests pass.
NEXT_PUBLIC_VENTO_PUSH_SUBSCRIPTIONS_ENABLED=false
NEXT_PUBLIC_VENTO_PUSH_VAPID_PUBLIC_KEY=

# Descriptive support vehicle profile; enable only after its reviewed migration and QA.
NEXT_PUBLIC_VENTO_SUPPORT_VEHICLE_PROFILE_ENABLED=false
