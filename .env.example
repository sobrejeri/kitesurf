# Copy to .env.local for development. Only public values: the anon (publishable)
# key is meant for browsers and only grants what row level security allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# #93: interrupção de aula e retomada pelo instrutor. DESLIGADA por padrão: só ligue depois de aplicada a migration
# 20261121120000 e da revisão. Qualquer valor diferente de "true" mantém o fluxo antigo.
NEXT_PUBLIC_VENTO_INTERRUPTION_FLOW_ENABLED=false
